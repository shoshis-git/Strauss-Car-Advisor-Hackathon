# Copy to .env and fill in. .env is git-ignored - never commit real keys.
# After editing .env, RESTART the server (uvicorn --reload watches .py files, not .env).
# Check the configuration with:  python -m backend.agent.llm_check
#
# LLM_PROVIDER (required): openai | anthropic | gemini | groq | openrouter | ollama |
#   openai_compatible | litellm
#   'rules' = deterministic brain WITHOUT a language model - for automated tests/offline only.
LLM_PROVIDER=gemini

# Model name as the provider expects it, e.g.:
#   openai: gpt-4.1   anthropic: claude-opus-5-5   gemini: gemini-3.8-flash   ollama: llama3.1
#   litellm: gemini/gemini-3.8-flash, anthropic/claude-opus-5-5, ...
LLM_MODEL=

# API key (if empty, the provider's own variable is used: OPENAI_API_KEY /
# ANTHROPIC_API_KEY / GEMINI_API_KEY / GROQ_API_KEY / OPENROUTER_API_KEY). Not for ollama.
LLM_API_KEY=

# Optional endpoint override; required for openai_compatible (vLLM, LM Studio, Azure, ...)
LLM_BASE_URL=

# Backup providers / keys (optional, up to _5): the same variables with a suffix.
# When one fails (daily quota, credit, bad key, outage) the next one answers the same
# request; the failed one rests for LLM_FAILOVER_COOLDOWN_S seconds (default 600) and is
# then tried first again - so a reset daily quota brings it back without editing .env.
# Pick models that support tool calling (and images, for unreadable payslips); check
# each one with:  python -m backend.agent.llm_check
#LLM_PROVIDER_2=groq
#LLM_MODEL_2=
#LLM_API_KEY_2=
#LLM_PROVIDER_3=openrouter
#LLM_MODEL_3=
#LLM_API_KEY_3=
#LLM_FAILOVER_COOLDOWN_S=600

# Retries of the same provider on a short failure (HTTP 503/502/500/504, timeout, network,
# 429 with Retry-After) before moving on to the next one. Exponential backoff with jitter:
# a random wait up to BASE_S * 2^n seconds (at most MAX_DELAY_S), or the provider's own
# Retry-After. All attempts of one request stay within BUDGET_S. LLM_RETRY_MAX=0 = off.
#LLM_RETRY_MAX=3
#LLM_RETRY_BASE_S=1
#LLM_RETRY_MAX_DELAY_S=16
#LLM_RETRY_BUDGET_S=90

# What to do when the language model fails (credits, quota, outage):
#   none  (default) - the employee sees the real cause; nothing is answered without the LLM
#   rules           - the deterministic brain answers that turn instead (with a notice)
LLM_FALLBACK=none

# Representative screen key (sent as the X-Rep-Token header). Required for the rep screen
# and /api/llm/check - when empty they are closed. Use a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
REP_API_KEY=

# Payslips without readable text (scans, glyph-code fonts) are read from their page image
# by the language model above (it must accept images - Gemini / GPT / Claude do).
#   on (default) | off - such payslips are refused and the employee types the data
PAYSLIP_VISION=on

# Interactive API docs (/docs). 0 = off (recommended in production).
API_DOCS=1

# Conversations database. Empty = local SQLite (data/app_data.db).
# Production: Supabase -> Connect -> Transaction pooler URI (port 6543), e.g.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Extra allowed browser origins (localhost is always allowed), comma-separated.
# Production: the Vercel address, e.g. https://strauss-car-advisor.vercel.app
CORS_ORIGINS=
