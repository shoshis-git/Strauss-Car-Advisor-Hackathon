# Copy to .env and fill in. .env is git-ignored - never commit real keys.
#
# LLM_PROVIDER: rules (default - offline, deterministic, no key) | openai | anthropic |
#               gemini | ollama | openai_compatible | litellm
LLM_PROVIDER=rules

# Model name as the provider expects it, e.g.:
#   openai: gpt-4.1   anthropic: claude-opus-5-5   gemini: gemini-2.5-pro   ollama: llama3.1
#   litellm: gemini/gemini-2.5-pro, anthropic/claude-opus-5-5, ...
LLM_MODEL=

# API key (if empty, the provider's own variable is used: OPENAI_API_KEY /
# ANTHROPIC_API_KEY / GEMINI_API_KEY). Not needed for ollama.
LLM_API_KEY=

# Optional endpoint override; required for openai_compatible (vLLM, LM Studio, Azure, ...)
# e.g. http://localhost:8000/v1
LLM_BASE_URL=
